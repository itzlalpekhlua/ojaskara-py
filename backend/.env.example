# Copy this file to .env and fill in real values. Generate a secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SESSION_SECRET=

# Only needed if you're not using the defaults (see README.md).
# PORT=8000
# HOST=0.0.0.0
# FRONTEND_INTERNAL_PORT=4000

# Split deployment only (frontend hosted separately, e.g. on Vercel) — see
# DEPLOYMENT.md. Leave both unset for single-server hosting.
# MANAGE_FRONTEND=false
# COOKIE_DOMAIN=.example.com
