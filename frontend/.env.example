# Copy this file to .env.local and fill in real values.

# The site's public domain, used for canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml. Defaults to https://ojaskaraabuilders.com —
# only set this when serving the same build from another origin (staging,
# preview deployment). No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://ojaskaraabuilders.com

# Must match the backend's own ADMIN_SESSION_SECRET exactly — both sides
# verify the same signed login cookie.
ADMIN_SESSION_SECRET=

# Where this app's server-side code (pages, Server Actions) reaches the
# FastAPI backend. Single-server hosting: leave as the default, loopback
# address — the backend runs alongside this app either way. Split hosting
# (this app on Vercel, backend elsewhere): set to the backend's public URL.
BACKEND_URL=http://127.0.0.1:8000

# Split deployment only — leave unset for single-server hosting. The
# backend's public URL, used by browser-side code (login, logout, file
# uploads) instead of a same-origin relative path. Requires the backend's
# COOKIE_DOMAIN to be set to a parent domain shared with this app — see
# DEPLOYMENT.md.
# NEXT_PUBLIC_BACKEND_URL=https://api.example.com
